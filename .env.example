# Public values: include only details that may be visible to all visitors.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# International number with country code, digits only. Leave blank until ready.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
# Keep false until the production domain, contact and privacy details are verified.
SITE_INDEXABLE=false

# Optional server-only receiver. Leave blank for the local-download preview.
# Must persist enquiries, enforce abuse controls and implement the receipt contract in README.md.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
